# Environment Configuration Example for Lovnish NIELIT ID Card Generator
# Rename this file to .env for production deployment

DEBUG=False
SECRET_KEY=replace-this-with-a-secure-random-key-in-production-min-50-characters
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.gov.in

# HTTPS & Security (Set to True when running behind SSL / HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
